generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile           TeacherProfile?
  documents         Document[]
  tags              Tag[]
  sharedResources   SharedResource[]
  resourceFavorites ResourceFavorite[]
  weekPlans         WeekPlan[]
  parentPortal      ParentPortal?
  students          Student[]
  whiteboard        Whiteboard?

  @@map("methodo_users")
}

model TeacherProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  grades    String[]
  subjects  String[]
  school     String?
  avatarUrl  String?  @map("avatar_url")
  language   String   @default("fr")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("methodo_teacher_profiles")
}

enum DocumentType {
  LESSON_PLAN
  WORKSHEET
  ASSESSMENT
  PARENT_MESSAGE
}

model Document {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  type       DocumentType
  title      String
  content    Json
  metadata   Json         @default("{}")
  isFavorite Boolean      @default(false) @map("is_favorite")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags TagOnDocument[]

  @@index([userId])
  @@index([userId, type])
  @@index([userId, isFavorite])
  @@map("methodo_documents")
}

model Tag {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now()) @map("created_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents TagOnDocument[]

  @@unique([userId, name])
  @@index([userId])
  @@map("methodo_tags")
}

model TagOnDocument {
  documentId String   @map("document_id")
  tagId      String   @map("tag_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("methodo_tags_on_documents")
}

model SharedResource {
  id          String   @id @default(cuid())
  authorId    String   @map("author_id")
  title       String
  description String   @default("")
  type        String
  grades      String[]
  subjects    String[]
  tags        String[]
  fileUrl     String?  @map("file_url")
  fileName    String?  @map("file_name")
  fileType    String?  @map("file_type")
  fileSize    Int?     @map("file_size")
  textContent String?  @map("text_content")
  downloads   Int      @default(0)
  isPublished   Boolean  @default(true) @map("is_published")
  isAiGenerated Boolean  @default(false) @map("is_ai_generated")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  favorites ResourceFavorite[]

  @@index([authorId])
  @@index([type])
  @@index([isPublished])
  @@map("methodo_shared_resources")
}

model ResourceFavorite {
  userId     String   @map("user_id")
  resourceId String   @map("resource_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource SharedResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
  @@map("methodo_resource_favorites")
}

model WeekPlan {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String   @default("Ma semaine")
  weekStart DateTime @map("week_start")
  slots     Json     @default("[]")
  periods   Json     @default("[]") @map("periods")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("methodo_week_plans")
}

model ParentPortal {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  slug      String   @unique
  className String   @default("") @map("class_name")
  messages  Json     @default("[]")
  agenda    Json     @default("[]")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("methodo_parent_portals")
}

model Student {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  firstName String   @map("first_name")
  lastName  String   @default("") @map("last_name")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("methodo_students")
}

model Whiteboard {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  widgets   Json     @default("[]")
  background Json    @default("{\"type\":\"color\",\"value\":\"#1e1b4b\"}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("methodo_whiteboards")
}
